# ==============================================================================
# PichoDescargas - Plantilla de Configuración para Producción (VPS / aaPanel)
# ==============================================================================

APP_NAME="PichoDescargas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------------------
# Logging (Rotación diaria para no saturar el disco del VPS)
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Base de Datos (MySQL / MariaDB en aaPanel)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pichodescargas_db
DB_USERNAME=pichodescargas_user
DB_PASSWORD=tu_password_seguro_aqui

# ------------------------------------------------------------------------------
# Sesiones, Caché y Colas
# ------------------------------------------------------------------------------
# Por defecto usando 'database' para máxima compatibilidad sin dependencias externas.
# Si instalaste Redis en aaPanel, puedes cambiar a 'redis'.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Configuración Redis (Opcional - si se instala en aaPanel)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Correo Electrónico (SMTP para notificaciones y reportes)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Almacenamiento en la Nube (Cloudflare R2 para Torrents / Assets)
# ------------------------------------------------------------------------------
# Si prefieres almacenar localmente en el VPS, deja 'public'.
# Para delegar a Cloudflare R2 sin costo de salida (egress free), configura 'r2'.
TORRENTMAC_STORAGE_DISK=public

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=pichodescargas-torrents
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://torrents.tudominio.com

# ------------------------------------------------------------------------------
# Telegram Bot (Notificaciones y Canal Automático)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Inteligencia Artificial (Auto-generación de descripciones y taxonomía)
# ------------------------------------------------------------------------------
CONTENT_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
